{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.crossref.org/schemas/crossref-work.schema.json",
  "title": "Crossref Work",
  "description": "JSON Schema for a single Crossref 'work' as returned by api.crossref.org (a subset of the crossref5.5.0 deposit XML). Root is one work object; apply to each line of a JSONL dump. Permissive: publisher-driven fields (reference, assertion, relation) allow extra properties.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "DOI",
    "URL",
    "content-domain",
    "created",
    "deposited",
    "indexed",
    "is-referenced-by-count",
    "issued",
    "prefix",
    "reference-count",
    "references-count",
    "resource",
    "score",
    "source",
    "type"
  ],
  "properties": {
    "DOI": { "type": "string", "pattern": "^10\\.[0-9]{4,}/.+$" },
    "URL": { "type": "string" },
    "prefix": { "type": "string" },
    "member": { "type": "string" },
    "publisher": { "type": "string" },
    "source": { "type": "string" },
    "score": { "type": "number" },
    "type": {
      "type": "string",
      "enum": [
        "book", "book-chapter", "book-part", "book-section",
        "component", "database", "dataset", "dissertation",
        "edited-book", "journal", "journal-article", "journal-issue",
        "monograph", "other", "peer-review", "posted-content",
        "proceedings", "proceedings-article", "reference-entry",
        "report", "report-component", "standard"
      ]
    },
    "subtype": { "type": "string" },
    "container-title": { "type": "array", "items": { "type": "string" } },
    "short-container-title": { "type": "array", "items": { "type": "string" } },
    "title": { "type": "array", "items": { "type": "string" } },
    "subtitle": { "type": "array", "items": { "type": "string" } },
    "short-title": { "type": "array", "items": { "type": "string" } },
    "original-title": { "type": "array", "items": { "type": "string" } },
    "abstract": { "type": "string" },
    "description": { "type": "string" },
    "alternative-id": { "type": "array", "items": { "type": "string" } },
    "archive": { "type": "array", "items": { "type": "string" } },
    "clinical-trial-number": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "clinical-trial-number": { "type": "string" },
              "registry": { "type": "string" }
            }
          }
        ]
      }
    },
    "ISSN": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{3}[0-9Xx]$" } },
    "ISBN": { "type": "array", "items": { "type": "string" } },
    "issn-type": { "type": "array", "items": { "$ref": "#/$defs/issnType" } },
    "isbn-type": { "type": "array", "items": { "$ref": "#/$defs/isbnType" } },
    "language": { "type": "string" },
    "author": { "type": "array", "items": { "$ref": "#/$defs/author" } },
    "editor": { "type": "array", "items": { "$ref": "#/$defs/author" } },
    "translator": { "type": "array", "items": { "$ref": "#/$defs/person" } },
    "chair": { "type": "array", "items": { "$ref": "#/$defs/author" } },
    "institution": { "type": "array", "items": { "$ref": "#/$defs/institution" } },
    "degree": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "array", "items": { "$ref": "#/$defs/license" } },
    "link": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "reference": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "assertion": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
    "funder": { "type": "array", "items": { "$ref": "#/$defs/funder" } },
    "update-to": { "type": "array", "items": { "$ref": "#/$defs/updateTo" } },
    "relation": { "$ref": "#/$defs/relation" },
    "resource": { "$ref": "#/$defs/resource" },
    "content-domain": { "$ref": "#/$defs/contentDomain" },
    "journal-issue": { "$ref": "#/$defs/journalIssue" },
    "event": { "$ref": "#/$defs/event" },
    "standards-body": { "type": "object" },
    "review": { "type": "object" },
    "volume": { "type": "string" },
    "issue": { "type": "string" },
    "page": { "type": "string" },
    "article-number": { "type": "string" },
    "edition-number": { "type": "string" },
    "group-title": { "type": "string" },
    "publisher-location": { "type": "string" },
    "created": { "$ref": "#/$defs/dateObj" },
    "deposited": { "$ref": "#/$defs/dateObj" },
    "indexed": { "$ref": "#/$defs/dateObj" },
    "issued": { "$ref": "#/$defs/dateObj" },
    "published": { "$ref": "#/$defs/dateObj" },
    "published-print": { "$ref": "#/$defs/dateObj" },
    "published-online": { "$ref": "#/$defs/dateObj" },
    "published-other": { "$ref": "#/$defs/dateObj" },
    "accepted": { "$ref": "#/$defs/dateObj" },
    "approved": { "$ref": "#/$defs/dateObj" },
    "posted": { "$ref": "#/$defs/dateObj" },
    "content-created": { "$ref": "#/$defs/dateObj" },
    "content-updated": { "$ref": "#/$defs/dateObj" },
    "update-policy": { "type": "string" },
    "is-referenced-by-count": { "type": "integer" },
    "reference-count": { "type": "integer" },
    "references-count": { "type": "integer" }
  },
  "$defs": {
    "dateObj": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date-parts"],
      "properties": {
        "date-parts": {
          "type": "array",
          "items": { "type": "array", "items": { "type": ["integer", "null"] }, "minItems": 1, "maxItems": 3 }
        },
        "date-time": { "type": "string" },
        "timestamp": { "type": "integer" }
      }
    },
    "contentDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": { "type": "array", "items": { "type": "string" } },
        "crossmark-restriction": { "type": "boolean" }
      }
    },
    "resourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["URL"],
      "properties": { "URL": { "type": ["string", "null"] } }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary"],
      "properties": {
        "primary": { "$ref": "#/$defs/resourceLink" },
        "secondary": { "type": "array", "items": { "$ref": "#/$defs/resourceLink" } }
      }
    },
    "journalIssue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue": { "type": "string" },
        "volume": { "type": "string" },
        "published-print": { "$ref": "#/$defs/dateObj" },
        "published-online": { "$ref": "#/$defs/dateObj" }
      }
    },
    "issnType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "type"],
      "properties": {
        "value": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{3}[0-9Xx]$" },
        "type": { "type": "string", "enum": ["print", "electronic"] }
      }
    },
    "isbnType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "type"],
      "properties": {
        "value": { "type": "string" },
        "type": { "type": "string", "enum": ["print", "electronic"] }
      }
    },
    "idRef": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "id-type": { "type": "string" },
        "asserted-by": { "type": "string" }
      }
    },
    "affiliation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "affiliation-name": { "type": "string" },
        "affiliation-id": { "type": "string" },
        "id": { "anyOf": [ { "type": "string" }, { "type": "array", "items": { "$ref": "#/$defs/idRef" } } ] },
        "scheme": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "code": { "type": "string" },
        "acronym": { "anyOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ] },
        "place": { "anyOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ] },
        "department": { "anyOf": [ { "type": "string" }, { "type": "array", "items": { "type": "string" } } ] }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "family": { "type": "string" },
        "given": { "type": "string" },
        "name": { "type": "string" },
        "suffix": { "type": "string" },
        "ORCID": { "type": "string" },
        "authenticated-orcid": { "type": "boolean" },
        "sequence": { "type": "string", "enum": ["first", "additional"] }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": { "type": "string" },
        "given": { "type": "string" },
        "name": { "type": "string" },
        "suffix": { "type": "string" },
        "ORCID": { "type": "string" },
        "authenticated-orcid": { "type": "boolean" },
        "sequence": { "type": "string", "enum": ["first", "additional"] },
        "affiliation": { "type": "array", "items": { "$ref": "#/$defs/affiliation" } }
      }
    },
    "institution": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "affiliation-name": { "type": "string" },
        "affiliation-id": { "type": "string" },
        "scheme": { "type": "string" },
        "city": { "type": "string" },
        "country": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["URL", "content-version", "delay-in-days"],
      "properties": {
        "URL": { "type": "string" },
        "content-version": { "type": "string" },
        "delay-in-days": { "type": "integer" },
        "license-version": { "type": "string" },
        "start": { "$ref": "#/$defs/dateObj" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["URL"],
      "properties": {
        "URL": { "type": "string" },
        "content-type": { "type": "string" },
        "content-version": { "type": "string" },
        "intended-application": { "type": "string" }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "key": { "type": "string" },
        "DOI": { "type": "string" },
        "ISSN": { "type": "string" },
        "ISBN": { "type": "string" },
        "issn-type": { "type": "string" },
        "isbn-type": { "type": "string" },
        "doi-asserted-by": { "type": "string" },
        "id": { "type": "string" },
        "id-type": { "type": "string" },
        "author": { "type": "string" },
        "year": { "type": "string" },
        "volume": { "type": "string" },
        "issue": { "type": "string" },
        "first-page": { "type": "string" },
        "last-page": { "type": "string" },
        "article-title": { "type": "string" },
        "journal-title": { "type": "string" },
        "volume-title": { "type": "string" },
        "series-title": { "type": "string" },
        "container-title": { "type": "string" },
        "edition": { "type": "string" },
        "unstructured": { "type": "string" }
      }
    },
    "assertionGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "name": { "type": "string" }, "label": { "type": "string" } }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" },
        "label": { "type": "string" },
        "order": { "type": "integer" },
        "group": { "$ref": "#/$defs/assertionGroup" },
        "explanation": { "type": "object" },
        "URL": { "type": "string" }
      }
    },
    "funderId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": { "type": { "type": "string" }, "value": { "type": "string" } }
    },
    "funderAward": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "award-number": { "type": "string" },
        "award-uri": { "type": "string" }
      }
    },
    "funder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "DOI": { "type": "string" },
        "doi-asserted-by": { "type": "string" },
        "id": { "type": "array", "items": { "$ref": "#/$defs/funderId" } },
        "award": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              { "$ref": "#/$defs/funderAward" }
            ]
          }
        }
      }
    },
    "updateTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["DOI"],
      "properties": {
        "DOI": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "updated": { "$ref": "#/$defs/dateObj" }
      }
    },
    "relationItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "id-type"],
      "properties": {
        "id": { "type": "string" },
        "id-type": { "type": "string" },
        "asserted-by": { "type": "string" },
        "id-asserted-by": { "type": "string" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
      "properties": {
        "is-same-as": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "is-identical-to": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "is-version-of": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "is-part-of": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "is-supplement-to": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "is-supplemented-by": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "is-comment-on": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "is-preprint-of": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "is-translation-of": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "is-review-of": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "has-review": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "has-preprint": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "has-related-material": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "has-translation": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "has-manifestation": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } },
        "references": { "type": "array", "items": { "$ref": "#/$defs/relationItem" } }
      }
    },
    "eventLocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "country": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "start": { "$ref": "#/$defs/dateObj" },
        "end": { "$ref": "#/$defs/dateObj" },
        "location": { "anyOf": [ { "type": "string" }, { "$ref": "#/$defs/eventLocation" } ] }
      }
    }
  }
}
