{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "rm *": "ask",
    "edit": {
      "/Users/oem/src/personal/nexus/**": "allow",
      "/tmp": "deny",
      "/tmp/**": "deny"
    }
  },
  "provider": {
    "wintermute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "wintermute",
      "options": {
        "baseURL": "http://192.168.0.24:8000/v1"
      },
      "models": {
        "nemotron3.5:30b-a3b": {
          "name": "Tooling and Exploration - Nemotron3.5 Lightning 30b-a3b" 
	},
        "gemma4:26b-a4b": {
          "name": "Documentation and Prose - Gemma4 26b-a4b" 
	},
        "qwen3.6:35b-a3b": {
          "name": "Coding - Qwen3.6 35b-a3b" 
	},
        "qwen3.8:27b": {
          "name": "Coding - Qwen3.8 27b",
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "body": {
            "reasoning_effort": "xhigh",
            "preserve_thinking": true
          },
          "variants": {
            "xhigh": {
              "name": "Max Reasoning (xhigh)",
              "body": {
                "reasoning_effort": "xhigh",
                "preserve_thinking": true
              }
            },
            "med": {
              "name": "Balanced (medium)",
              "body": {
                "reasoning_effort": "medium",
                "preserve_thinking": true
              }
            },
            "low": {
              "name": "Fast (low)",
              "body": {
                "reasoning_effort": "low",
                "preserve_thinking": true
              }
            },
            "off": {
              "name": "Thinking Disabled",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                },
                "preserve_thinking": false
              }
            }
          }
	}
      }
    }
  }
}
